<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .profile-card {
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    width: 100%;
    max-width: 380px;
    overflow: hidden;
    text-align: center;
  }

  .cover-photo {
    height: 110px;
    background: linear-gradient(120deg, #ff6a00, #ee0979);
  }

  .avatar-wrapper {
    margin-top: -60px;
  }

  .avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 5px solid #fff;
    object-fit: cover;
    background: #ddd;
  }

  .name {
    margin-top: 15px;
    font-size: 22px;
    font-weight: 700;
    color: #222;
  }

  .title {
    color: #777;
    font-size: 14px;
    margin-top: 4px;
    margin-bottom: 15px;
  }

  .bio {
    padding: 0 25px;
    font-size: 14px;
    color: #555;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  .stats {
    display: flex;
    justify-content: space-around;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
    padding: 15px 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 18px;
    font-weight: 700;
    color: #2575fc;
  }

  .stat-label {
    font-size: 12px;
    color: #999;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 15px;
    padding: 20px 0;
  }

  .social-links a {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #f2f2f2;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #555;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .social-links a:hover {
    background: #2575fc;
    color: #fff;
    transform: translateY(-3px);
  }

  .contact-btn {
    display: inline-block;
    margin: 0 0 25px 0;
    padding: 10px 30px;
    background: linear-gradient(120deg, #6a11cb, #2575fc);
    color: #fff;
    border: none;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .contact-btn:hover {
    opacity: 0.85;
  }
</style>
</head>
<body>

  <div class="profile-card">
    <div class="cover-photo"></div>

    <div class="avatar-wrapper">
      <img class="avatar" src=""C:\Users\sanjay\Downloads\IMG-20251107-WA0086 (1).jpg"" alt="Profile picture">
    </div>

    <div class="name">Aditi Singh</div>
    <div class="title">UI UX Designer</div>

    <p class="bio">
      Passionate about building clean, user-friendly web applications.
      Loves coffee, coding, and hiking on weekends.
    </p>

    <div class="stats">
      <div class="stat">
        <span class="stat-number">128</span>
        <span class="stat-label">Projects</span>
      </div>
      <div class="stat">
        <span class="stat-number">4.5K</span>
        <span class="stat-label">Followers</span>
      </div>
      <div class="stat">
        <span class="stat-number">312</span>
        <span class="stat-label">Following</span>
      </div>
    </div>

    <div class="social-links">
      <a href="#" title="Twitter">𝕏</a>
      <a href="#" title="LinkedIn">in</a>
      <a href="#" title="GitHub">GH</a>
      <a href="#" title="Instagram">IG</a>
    </div>

    <button class="contact-btn">Contact Me</button>
  </div>

</body>
</html>
